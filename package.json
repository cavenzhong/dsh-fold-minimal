{
  "name": "dsh-fold-minimal",
  "version": "0.3.0",
  "description": "侧栏折叠后，把左侧全局面板图标（插件 / 自动化任务 / 用户插件等）按左侧菜单顺序映射到窗口左上角的折叠工具栏；面板超过 4 个时第 4 格变成「更多」，悬停即展开其余面板；把侧栏拖到最小后继续往左拖，松手即收起；打开面板时，新建会话后还会出现「返回会话」按钮，一键回到最后一次工作的会话。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "author": "cavenzhong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavenzhong/dsh-fold-minimal.git"
  },
  "homepage": "https://github.com/cavenzhong/dsh-fold-minimal#readme",
  "bugs": {
    "url": "https://github.com/cavenzhong/dsh-fold-minimal/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "macos",
    "sidebar",
    "plugin",
    "productivity"
  ],
  "license": "MIT"
}
